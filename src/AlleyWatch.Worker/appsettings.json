{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Frigate": {
    "MqttHost": "localhost",
    "MqttPort": 1883,
    "ApiBaseUrl": "http://localhost:5000",
    "CameraName": "alley",
    "ZoneName": "alley_zone"
  },
  "Parking": {
    "ParkedThresholdMinutes": 10
  },
  "Claude": {
    "Model": "claude-sonnet-5",
    "MaxTokens": 1024,
    "MaxSampledFrames": 8
  },
  "Gmail": {
    "RecipientAddresses": [ "you@example.com" ],
    "TokenStorePath": "data\\gmail-token"
  },
  "Storage": {
    "DatabasePath": "data\\alleywatch.db"
  }
}
