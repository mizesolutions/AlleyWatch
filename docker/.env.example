# Copy this file to .env (gitignored) and fill in the real Wyze Cam v3 RTSPS credentials.
# Frigate substitutes these into docker/frigate/config.yml's {FRIGATE_RTSP_USER}/{FRIGATE_RTSP_PASSWORD}/{FRIGATE_CAMERA_HOST}.
FRIGATE_RTSP_USER=wyzecam
FRIGATE_RTSP_PASSWORD=changeme
FRIGATE_CAMERA_HOST=192.0.2.10
